    {
      "dot": "emerald",
      "title": "Retrieval",
      "items": [
        "Vectors from sessions, articles, topics and PDFs share one pool",
        "Rows from a different embedding model are excluded, never compared",
        "Verified notes get +0.2 before the top-k cut"
      ]
    },
    {
      "dot": "amber",
      "title": "Paid only when asked",
      "items": [
        "Synthesis is the server's one paid call; synthesize: false returns the notes alone",
        "The tool description tells the agent synthesis is billed",
        "Queries append to ~/.vir/queries.jsonl when logQueries is on (default)"
      ]
    },
    {
      "dot": "slate",
      "title": "Zero hits",
      "items": [
        "Returns 'No matching notes' and skips synthesis",
        "The other five MCP tools never call an LLM"
