  "cards": [
    {
      "dot": "cyan",
      "title": "No status column",
      "items": [
        "State is derived from skipped, skip_reason, error, attempts, pruned_at, rejected_at, archived",
        "record() resets attempts to 0 and never touches the overlays"
      ]
    },
    {
      "dot": "amber",
      "title": "Retry rules",
      "items": [
        "recordError stores the attempted hash, so vir run does not retry the same bytes",
        "Only vir reconcile retries, with vir run's filters; --force includes parked rows",
        "A failed reconcile retry also counts toward the 3-attempt bound"
      ]
    },
    {
      "dot": "emerald",
      "title": "Notes are never hidden by a skip",
      "items": [
        "A filter or low-confidence skip of a re-processed session keeps its note (keepNote)",
        "A one-time repair restored notes hidden by older versions"
      ]
    }
