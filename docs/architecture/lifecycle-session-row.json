  "cards": [
    {
      "dot": "cyan",
      "title": "No status column",
      "items": [
        "State is derived from skipped, skip_reason, error, attempts, pruned_at, rejected_at, archived",
        "record() resets attempts to 0 and never touches the overlays"
      ]
    },
    {
      "dot": "amber",
      "title": "Retry rules",
      "items": [
        "recordError stores the attempted hash, so vir run does not retry the same bytes",
        "attempts only climbs on a changed transcript or --full",
        "Only vir reconcile retries; --force includes parked rows"
      ]
    },
    {
      "dot": "rose",
      "title": "Gaps",
      "items": [
        "A failed reconcile retry does not bump attempts",
        "Filter / low-confidence skips can overwrite a distilled row on re-run"
      ]
    }
  ]
