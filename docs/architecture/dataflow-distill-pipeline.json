  "cards": [
    {
      "dot": "emerald",
      "title": "Free before paid",
      "items": [
        "Scan, category, project, cache, prune and 3-strike gates all run before any LLM call",
        "A 5-token preflight probe aborts the whole run on a provider outage",
        "Every config-driven skip writes a skip_reason row"
      ]
    },
    {
      "dot": "amber",
      "title": "Failure handling",
      "items": [
        "recordError bumps attempts; 3 consecutive failures park the session",
        "Only vir reconcile --force retries a parked session",
        "A claude-cli quota hit halts the loop with no error rows"
      ]
    },
    {
      "dot": "violet",
      "title": "After the loop",
      "items": [
        "Project summaries for projects with 3+ new notes",
        "Embedding sweep back-fills NULL vectors (Ollama or local)",
        "Articles and PDFs run their own phase via the same callLLM"
      ]
    }
  ]
