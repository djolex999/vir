---
// The full graph-spiral mark with the "distill" sequence: arms draw inward,
// nodes light up outer → inner, the core flashes last. CSS only; plays once
// on load, replays on hover. Reduced motion shows the still mark.
import svg from "../assets/logo.svg?raw";
const inner = svg.split("</desc>")[1].split("</svg>")[0].replace(/id="g"/, 'id="vir-hero-g"').replace(/url\(#g\)/g, "url(#vir-hero-g)");
interface Props { size?: number }
const { size = 128 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 256 256" class="logo-anim" aria-hidden="true" set:html={inner} />

<style is:global>
  .logo-anim { animation: logo-spin 80s linear infinite; transform-origin: center; }
  .logo-anim path { stroke-dasharray: 700; stroke-dashoffset: 700; animation: logo-arm 1.1s cubic-bezier(.4,0,.2,1) forwards; }
  /* two animations per node: the one-time light-up, then an endless pulse
     that inherits the same delay so it travels outer → inner as a wave */
  .logo-anim circle {
    opacity: 0; transform-box: fill-box; transform-origin: center;
    animation: logo-node 400ms ease-out forwards, logo-pulse 3.2s ease-in-out 1.8s infinite;
  }
  /* nodes are authored outer→inner per arm; circles 1-11, 12-22, 23-33 are the arms, 34 is the core */
  .logo-anim circle:nth-of-type(1),  .logo-anim circle:nth-of-type(12), .logo-anim circle:nth-of-type(23) { animation-delay: 1.25s, 3.05s; }
  .logo-anim circle:nth-of-type(2),  .logo-anim circle:nth-of-type(13), .logo-anim circle:nth-of-type(24) { animation-delay: 1.15s, 2.95s; }
  .logo-anim circle:nth-of-type(3),  .logo-anim circle:nth-of-type(14), .logo-anim circle:nth-of-type(25) { animation-delay: 1.05s, 2.85s; }
  .logo-anim circle:nth-of-type(4),  .logo-anim circle:nth-of-type(15), .logo-anim circle:nth-of-type(26) { animation-delay: 0.95s, 2.75s; }
  .logo-anim circle:nth-of-type(5),  .logo-anim circle:nth-of-type(16), .logo-anim circle:nth-of-type(27) { animation-delay: 0.85s, 2.65s; }
  .logo-anim circle:nth-of-type(6),  .logo-anim circle:nth-of-type(17), .logo-anim circle:nth-of-type(28) { animation-delay: 0.72s, 2.52s; }
  .logo-anim circle:nth-of-type(7),  .logo-anim circle:nth-of-type(18), .logo-anim circle:nth-of-type(29) { animation-delay: 0.58s, 2.38s; }
  .logo-anim circle:nth-of-type(8),  .logo-anim circle:nth-of-type(19), .logo-anim circle:nth-of-type(30) { animation-delay: 0.44s, 2.24s; }
  .logo-anim circle:nth-of-type(9),  .logo-anim circle:nth-of-type(20), .logo-anim circle:nth-of-type(31) { animation-delay: 0.3s, 2.10s; }
  .logo-anim circle:nth-of-type(10), .logo-anim circle:nth-of-type(21), .logo-anim circle:nth-of-type(32) { animation-delay: 0.16s, 1.96s; }
  .logo-anim circle:nth-of-type(11), .logo-anim circle:nth-of-type(22), .logo-anim circle:nth-of-type(33) { animation-delay: 0.02s, 1.82s; }
  .logo-anim circle:nth-of-type(34) { animation: logo-core 600ms ease-out 1.35s forwards, logo-breathe 3.2s ease-in-out 2s infinite; }
  /* nav mark: still by default, runs the same sequence on hover of its link */
  .group:hover .logo-hover path { stroke-dasharray: 700; stroke-dashoffset: 700; animation: logo-arm 0.9s cubic-bezier(.4,0,.2,1) forwards; }
  .group:hover .logo-hover circle { transform-box: fill-box; transform-origin: center; animation: logo-node 500ms ease-out both; animation-delay: calc(0.85s - var(--i, 0) * 0.09s); }
  @keyframes logo-arm { to { stroke-dashoffset: 0; } }
  @keyframes logo-spin { to { transform: rotate(360deg); } }
  @keyframes logo-pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.45); } }
  @keyframes logo-breathe { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.25); } }
  @keyframes logo-node { from { opacity: 0; transform: scale(0.4); } to { opacity: 1; transform: scale(1); } }
  @keyframes logo-core { 0% { opacity: 0; transform: scale(0.2); } 60% { opacity: 1; transform: scale(1.5); } 100% { opacity: 1; transform: scale(1); } }
  @media (prefers-reduced-motion: reduce) {
    .logo-anim, .logo-anim path, .logo-anim circle { animation: none !important; opacity: 1; stroke-dashoffset: 0; }
  }
</style>
