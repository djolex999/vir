---
interface Line { kind: "cmd" | "out" | "dim" | "link"; text: string }
interface Props { lines: Line[]; label: string }
const { lines, label } = Astro.props;
---
<figure class="min-w-0 overflow-hidden border border-rule bg-code text-[0.82rem] leading-[1.65] text-[#e8e8f0]" aria-label={label}>
  <div class="flex items-center gap-1.5 border-b border-white/10 px-3 py-2" aria-hidden="true">
    <span class="h-2 w-2 rounded-full bg-white/20"></span>
    <span class="h-2 w-2 rounded-full bg-white/20"></span>
    <span class="h-2 w-2 rounded-full bg-white/20"></span>
  </div>
  <pre class="m-0 overflow-x-auto p-4 font-mono whitespace-pre-wrap [overflow-wrap:anywhere]">{lines.map((l) => (
    <span class:list={["block", l.kind === "dim" && "text-white/45", l.kind === "link" && "text-[#b7adff]", l.kind === "cmd" && "text-white"]}>{l.kind === "cmd" ? "$ " : ""}{l.text}</span>
  ))}</pre>
</figure>
