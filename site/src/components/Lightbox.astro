---
import { Image } from "astro:assets";
import graph from "../assets/graph.png";
interface Props { alt: string }
const { alt } = Astro.props;
---
<dialog id="graph-lightbox" class="m-auto max-h-[92vh] max-w-[92vw] border border-rule bg-paper p-2 backdrop:bg-black/70">
  <form method="dialog" class="flex justify-end">
    <button type="submit" class="font-mono text-[0.75rem] uppercase tracking-wider text-ink-muted px-2 py-1 hover:text-ink" aria-label="Close">Close ✕</button>
  </form>
  <Image src={graph} alt={alt} widths={[1200, 1700]} format="webp" quality={82} loading="lazy" class="max-h-[84vh] w-auto" />
</dialog>

<script>
  const dlg = document.getElementById("graph-lightbox") as HTMLDialogElement | null;
  const opener = document.querySelector<HTMLButtonElement>("[data-open-graph]");
  if (dlg && opener) {
    opener.addEventListener("click", () => dlg.showModal());
    dlg.addEventListener("click", (e) => {
      if (e.target === dlg) dlg.close();
    });
  }
</script>
